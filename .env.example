# --- Application ---
APP_NAME="SGI Optica"
ENVIRONMENT=local
DEBUG=true

# --- Database ---
# Used by the app and Alembic. Override in CI/prod.
DATABASE_URL=postgresql+psycopg2://sgi:sgi@localhost:5432/sgi

# --- Security ---
# Generate a strong value for production, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# --- Tenancy ---
# Which company the seed builds. Login does NOT read this: a session's company
# comes from the authenticated user, so one deployment serves every óptica.
DEFAULT_COMPANY_ID=1

# --- Provider (platform) admin ---
# The bootstrap login for the provider console at /admin, created by
# `python -m scripts.seed`. This account can enter ANY tenant's data.
# The seed only accepts these defaults when ENVIRONMENT=local; anywhere else it
# refuses and tells you to run `python -m scripts.platform_admin create`.
PLATFORM_ADMIN_EMAIL=owner@sgi.com
PLATFORM_ADMIN_PASSWORD=owner1234

# --- Email ---
# Where the app lives as a browser sees it. Invitation and password-reset links
# are built from this, so a wrong value mails people a dead link.
PUBLIC_BASE_URL=http://localhost:8000

# console (print, send nothing) | memory (tests) | smtp (any provider) | resend | brevo
EMAIL_BACKEND=console
EMAIL_FROM="Mi Óptica Digital <no-reply@miopticadigital.com.ar>"

# SMTP — works with Brevo, Resend, SendGrid, Mailgun, Gmail. Use 587+STARTTLS:
# port 25 is blocked outbound on most PaaS hosts, Render included.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# HTTPS APIs — preferred over SMTP on a PaaS, where SMTP ports are often blocked.
# Resend is the configured provider; the key starts with "re_".
RESEND_API_KEY=
BREVO_API_KEY=

# Link lifetimes. An invitation may sit unopened over a weekend; a reset is
# requested by someone waiting at their screen.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_HOURS=1
